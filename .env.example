# Variables de entorno de LOMS 360. Copiar a .env.local para desarrollo; en
# producción se cargan en Vercel → Settings → Environment Variables.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor: la usa la tarea diaria (/api/cron/diario), que corre sin
# usuario logueado. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Clave que Vercel manda a la tarea diaria ("Authorization: Bearer ...").
# Cualquier texto largo al azar, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Opcional, solo desarrollo: a dónde vuelve el enlace de confirmación de correo
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
